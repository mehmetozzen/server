# =============================================================
# Kaltura CE Docker Configuration
# Create your config with random secrets pre-filled:
#   make -C docker config
# (or copy this file to kaltura.conf and fill in the CHANGEME values —
#  the containers REFUSE to boot while a CHANGEME placeholder remains).
# kaltura.conf is git-ignored — never commit real credentials.
#
# Run the stack:
#   make -C docker up
#   (equivalent: docker compose --env-file ./kaltura.conf -f docker/docker-compose.yml up -d)
# =============================================================

# ── Domain ────────────────────────────────────────────────────
WWW_HOST=kaltura.example.com
PROTOCOL=http

# ── SSL (required when PROTOCOL=https) ────────────────────────
# Paths inside the container. Put your cert files in docker/certs/
# and they will be available at /opt/kaltura/certs/ inside the container.
#   mkcert -cert-file docker/certs/server.crt \
#           -key-file  docker/certs/server.key \
#           kaltura.example.com
SSL_CRT_FILE=/opt/kaltura/certs/server.crt
SSL_KEY_FILE=/opt/kaltura/certs/server.key
# SSL_CA_FILE=/opt/kaltura/certs/chain.crt

# For local dev with mkcert (self-signed): copy the mkcert root CA here.
# The container will automatically install it into its trust store.
#   cp "$(mkcert -CAROOT)/rootCA.pem" docker/certs/rootCA.pem

# ── Database ──────────────────────────────────────────────────
# Use 'mysql' for Docker internal networking.
# `make config` generates strong random passwords here; the entrypoints
# hard-fail on empty or CHANGEME values (no silent weak defaults).
DB1_HOST=mysql
DB1_PORT=3306
DB1_NAME=kaltura
DB1_USER=kaltura
DB1_PASS=CHANGEME
MYSQL_ROOT_PASSWORD=CHANGEME

# ── Admin Console ─────────────────────────────────────────────
ADMIN_CONSOLE_ADMIN_MAIL=admin@example.com
ADMIN_CONSOLE_PASSWORD=CHANGEME

# ── Timezone ──────────────────────────────────────────────────
TIME_ZONE=UTC

# ── Logging ───────────────────────────────────────────────────
# Zend_Log priority kept on disk (messages at this level and below).
# Kaltura ships with the filter disabled, i.e. everything including DEBUG:
# on an idle install that is ~78% of the volume and 36 MB in 35 minutes.
#   7 = DEBUG (very chatty — raise to this only while troubleshooting)
#   6 = INFO (default)   5 = NOTICE   4 = WARN   3 = ERR
LOG_LEVEL=6

# ── Outgoing e-mail (password reset, invitations, bulk-upload results) ──
# Without SMTP_HOST all outgoing mail is DISABLED (a WARN is logged at boot).
# Point it at your relay (e.g. smtp.eu.mailgun.org) or, for dev, at a local
# mailpit/mailhog container with SMTP_TLS=off. Such a sink is deliberately NOT
# part of this stack — a catcher left running on a live host silently swallows
# password-reset mail. Run one alongside only while testing:
#   docker run -d --name mailpit --network docker_default -p 127.0.0.1:8025:8025 axllent/mailpit
# then set SMTP_HOST=mailpit SMTP_PORT=1025 SMTP_TLS=off SMTP_STARTTLS=off
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=on
SMTP_STARTTLS=on
SMTP_USER=
SMTP_PASS=
# Envelope sender; default no-reply@$WWW_HOST
SMTP_FROM=
# Forum link used in mail footers (default https://forum.kaltura.org)
# FORUMS_URL=

# ── Live streaming ────────────────────────────────────────────
# Publish auth shared secret for MANUAL live streams: encoders must push
#   rtmp://<host>:1935/kLive/<stream>?token=<LIVE_PUBLISH_TOKEN>
# (?t= also accepted; in OBS put it on the Server field: rtmp://<host>/kLive?token=...)
# Native Kaltura-Live entries authenticate with their own streamPassword instead.
# FAIL-CLOSED: with no token configured publishing is REFUSED, unless you
# explicitly set LIVE_ALLOW_ANON_PUBLISH=1 (isolated dev boxes only).
# `make config` generates a random token here.
LIVE_PUBLISH_TOKEN=
# LIVE_ALLOW_ANON_PUBLISH=1

# Internal shared secret between the live-rtmp container and the
# analytics-receiver's /live/* callbacks (generated by `make config`).
# Empty = callbacks unauthenticated (any container on the network could
# drive live state) — leave the generated value in place.
LIVE_CB_SECRET=

# CORS origin served on live HLS output. Default * (external embeds work).
# Set to your site origin (e.g. https://kaltura.example.com) to stop
# third-party pages from hotlinking your live streams.
# LIVE_CORS_ORIGIN=

# Partner that owns automatic VOD recordings of live streams
# (empty = recording upload off)
LIVE_PARTNER_ID=

# ── Analytics ─────────────────────────────────────────────────
# The whole analytics backend: 7 Druid services + Kafka, ~4.2 GB RAM.
# Kafka's only consumer is Druid, so the two are one unit and this single
# switch starts or stops both. Comment it out to run without analytics —
# VOD, live streaming, KMC and search are unaffected, only the analytics
# tabs go empty and the receiver settles into its batch fallback.
COMPOSE_PROFILES=analytics

# Override only to point at a Kafka outside this stack. Left unset it
# defaults to the bundled broker (kafka:9092) whenever analytics is on.
# KAFKA_BROKERS=

# Legacy DWH schema load on first boot. It has NO ETL feeding it in this
# stack (analytics is Druid-only) — the schema only keeps legacy DWH reports
# (Admin Console partner-usage) failing soft/empty instead of erroring.
# Set to false to skip and save several minutes of first-boot time.
# LOAD_DWH=true
